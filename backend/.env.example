# Copy to .env and edit
PORT=3000
NODE_ENV=development

# REQUIRED in production: long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# SQLite file (use :memory: for tests)
DB_PATH=./data/kamagere.db

# Comma-separated origins allowed to call the API from a different origin (e.g. VS Code Live Server)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: first admin account, created on startup if no admin exists
ADMIN_NAME=Store Admin
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword1

# Delivery rule (frontend shows the same numbers)
DELIVERY_FEE=25
FREE_DELIVERY_THRESHOLD=199

# Optional: Razorpay for UPI/online payments (leave blank to disable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
